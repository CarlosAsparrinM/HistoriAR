# API Configuration
# Android Emulator en desarrollo. Para release debe ser una URL HTTPS.
API_BASE_URL=http://10.0.2.2:4000
API_TIMEOUT=30000

# Environment
ENVIRONMENT=development

# Location Services
LOCATION_UPDATE_INTERVAL=5000
LOCATION_ACCURACY=best

# AR Features
AR_ENABLED=true

# Debug
DEBUG_MODE=false

# OAuth Client ID used by the mobile Google Sign-In integration. This is a
# public identifier; do not add a client secret to a Flutter app.
GOOGLE_CLIENT_ID=your_mobile_client_id.apps.googleusercontent.com
