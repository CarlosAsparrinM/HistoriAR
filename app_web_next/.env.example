# API usada desde Server Components. Nunca incluyas secretos aquí.
HISTORIAR_API_BASE_URL=http://localhost:4000/api

# API usada por navegador para evaluación del quiz. Debe tener CORS configurado.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
# URL pública canónica, sin barra final. En producción es obligatoria para SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3005
NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.historiar.app
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_APP_ENV=development
